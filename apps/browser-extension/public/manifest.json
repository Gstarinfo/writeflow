{
  "manifest_version": 3,
  "name": "WriteFlow — Local Writing Assistant",
  "version": "1.0.0",
  "description": "Fast, private, local English writing assistance with grammar, spelling, and Open English WordNet synonyms.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "WriteFlow Assistant"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
